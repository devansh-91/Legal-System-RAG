# ---------------------------------------------------------------
# LLM provider: "groq" (free API tier), "ollama" (local, 100% free)
# or "huggingface" (free Inference API credits)
# ---------------------------------------------------------------
LLM_PROVIDER=groq

# Groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — install from https://ollama.com then: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face — free token at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------
# Embeddings (run locally via sentence-transformers, no key needed)
# For Hindi / regional-language queries try:
#   EMBEDDING_MODEL=intfloat/multilingual-e5-small
# ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------
# Vector store / retrieval
# ---------------------------------------------------------------
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=indian_legal_kb
DATA_DIR=./data
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
